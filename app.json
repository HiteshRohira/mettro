{
  "expo": {
    "name": "Mettro",
    "slug": "mettro",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mettro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hiteshrohira.mettro",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mettro uses your location to find the nearest metro station and track your trip stop by stop.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Mettro uses your location during an active trip to keep your Live Activity updated and alert you before your stop, even when the app is in the background.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "processing"
        ],
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.hiteshrohira.mettro",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MetroStatusWidget",
              "displayName": "Metro Status",
              "description": "Line status and your nearest station at a glance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widgets/StatusWidget.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
